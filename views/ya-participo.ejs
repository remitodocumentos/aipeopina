<%- include('partials/header') %>

<div class="container">
    <div class="mensaje-participacion">
        <div class="icono-advertencia">⚠️</div>
        
        <% if (tipo === 'funcionarios') { %>
            <h1>Ya participaste en la calificación de funcionarios</h1>
            <p>Tu dispositivo ya ha completado la calificación de funcionarios municipales.</p>
            <p>Solo se permite una participación por dispositivo para mantener la integridad de los resultados.</p>
        <% } else if (tipo === 'administrativas') { %>
            <h1>Ya participaste en la calificación administrativa</h1>
            <p>Tu dispositivo ya ha completado la calificación de la gestión administrativa.</p>
            <p>Solo se permite una participación por dispositivo para mantener la integridad de los resultados.</p>
        <% } else { %>
            <h1>Ya participaste</h1>
            <p>Tu dispositivo ya ha completado una calificación anteriormente.</p>
            <p>Solo se permite una participación por dispositivo.</p>
        <% } %>
        
        <div class="acciones">
            <a href="/resultados" class="btn-primary">Ver Resultados</a>
            <a href="/" class="btn-secondary">Volver al Inicio</a>
        </div>
    </div>
</div>

<style>
.mensaje-participacion {
    max-width: 600px;
    margin: 100px auto;
    padding: 40px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    text-align: center;
}

.icono-advertencia {
    font-size: 4rem;
    color: #ffc107;
    margin-bottom: 20px;
}

.mensaje-participacion h1 {
    color: #2c5aa0;
    margin-bottom: 20px;
}

.acciones {
    margin-top: 30px;
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-primary, .btn-secondary {
    padding: 12px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
    transition: all 0.3s ease;
    display: inline-block;
}

.btn-primary {
    background: #2c5aa0;
    color: white;
}

.btn-primary:hover {
    background: #1a3a6e;
    transform: translateY(-2px);
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn-secondary:hover {
    background: #5a6268;
    transform: translateY(-2px);
}

@media (max-width: 768px) {
    .mensaje-participacion {
        margin: 50px 20px;
        padding: 30px 20px;
    }
    
    .acciones {
        flex-direction: column;
    }
}
</style>

<%- include('partials/footer') %>
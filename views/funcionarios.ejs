<%- include('partials/header') %>

<div class="evaluacion-container">
    <h2>Examinación de Funcionarios Municipales</h2>

    <form action="/evaluacion/funcionarios" method="POST" id="funcionarios-form" onsubmit="return false;"> 
        <!-- Campos de información del participante -->
        <div class="participacion-info">
            <h3>Información del Participante</h3>
            <div class="opciones-participacion">
                <div class="opcion-participacion">
                    <input type="radio" id="anonimo" name="tipo_participacion" value="anonimo" checked>
                    <label for="anonimo">Participar de forma anónima</label>
                </div>
                <div class="opcion-participacion">
                    <input type="radio" id="con_nombre" name="tipo_participacion" value="con_nombre">
                    <label for="con_nombre">Participar con mi nombre</label>
                </div>
            </div>
            
            <div id="campo_nombre" class="campo-nombre" style="display: none;">
                <label for="nombre">Tu nombre:</label>
                <input type="text" id="nombre" name="nombre" placeholder="Ingresa tu nombre completo" onkeypress="return event.key !== 'Enter';">
            </div>
            
            <input type="hidden" id="dispositivo_id" name="dispositivo_id" value="<%= dispositivoId %>">
        </div>
        
        <% funcionarios.forEach((funcionario, index) => { %>
        <div class="funcionario-section" id="funcionario-<%= funcionario.id %>" <%= index > 0 ? 'style="display:none;"' : '' %>>
            <h3><%= funcionario.seccion %></h3>
            <div class="funcionario-info">
                <h4><%= funcionario.nombre %></h4>
                <p><%= funcionario.cargo %></p>
            </div>
            
            <div class="preguntas-grid">
                <% preguntas.forEach((pregunta) => { %>
                <div class="pregunta-item">
                    <p><%= pregunta.texto %></p>
                    <div class="opciones">
                        <% ['excelente', 'bueno', 'regular', 'deficiente', 'malo'].forEach(opcion => { %>
                        <label>
                            <input type="radio" 
                                   name="<%= funcionario.id %>-<%= pregunta.id %>" 
                                   value="<%= opcion %>"
                                   class="pregunta-radio">
                            <%= opcion.charAt(0).toUpperCase() + opcion.slice(1) %>
                        </label>
                        <% }); %>
                    </div>
                </div>
                <% }); %>
            </div>
            
            <% if (index < funcionarios.length - 1) { %>
            <button type="button" class="btn-siguiente" onclick="mostrarSiguiente('<%= funcionario.id %>')">
                Siguiente Funcionario
            </button>
            <% } else { %>
            <button type="button" class="btn-primary" onclick="validarYEnviarFormulario()" id="btn-enviar">
                Enviar Evaluación
            </button>
            <% } %>
        </div>
        <% }); %>
    </form>
</div>

<script>
// Función de validación mejorada
function validarYEnviarFormulario() {
    console.log('=== VALIDANDO FORMULARIO ===');
    
    const dispositivoIdInput = document.getElementById('dispositivo_id');
    const btnEnviar = document.getElementById('btn-enviar');
    const form = document.getElementById('funcionarios-form');
    
    // 1. Asegurar dispositivo_id
    if (!dispositivoIdInput.value) {
        dispositivoIdInput.value = generarUUID();
        console.log('Dispositivo ID generado:', dispositivoIdInput.value);
    }
    
    // 2. Validar que TODAS las preguntas de TODOS los funcionarios tengan respuesta
    let todasRespondidas = true;
    const preguntasSinResponder = [];
    
    // Revisar todos los funcionarios (visibles y no visibles)
    const todosLosFuncionarios = document.querySelectorAll('.funcionario-section');
    
    todosLosFuncionarios.forEach(seccion => {
        const gruposPreguntas = {};
        
        // Encontrar todos los grupos de preguntas en esta sección
        const radios = seccion.querySelectorAll('.pregunta-radio');
        radios.forEach(radio => {
            if (!gruposPreguntas[radio.name]) {
                gruposPreguntas[radio.name] = false;
            }
        });
        
        // Verificar cuáles grupos tienen respuesta
        const radiosMarcados = seccion.querySelectorAll('.pregunta-radio:checked');
        radiosMarcados.forEach(radio => {
            gruposPreguntas[radio.name] = true;
        });
        
        // Revisar qué grupos faltan
        for (const [grupo, respondido] of Object.entries(gruposPreguntas)) {
            if (!respondido) {
                todasRespondidas = false;
                preguntasSinResponder.push(grupo);
                console.log('❌ Pregunta sin responder:', grupo);
            }
        }
    });
    
    if (!todasRespondidas) {
        // Mostrar cuántas preguntas faltan
        const faltan = preguntasSinResponder.length;
        alert(`Faltan ${faltan} pregunta(s) por responder. Por favor, revisa todas las secciones.`);
        
        // Opcional: Mostrar la primera sección con preguntas faltantes
        if (preguntasSinResponder.length > 0) {
            const primeraPreguntaFaltante = preguntasSinResponder[0];
            const [funcionarioId] = primeraPreguntaFaltante.split('-');
            mostrarSeccion(funcionarioId);
        }
        
        return false;
    }
    
    console.log('✅ Todas las preguntas respondidas');
    
    // 3. Mostrar loading y enviar
    btnEnviar.disabled = true;
    btnEnviar.textContent = 'Enviando...';
    
    console.log('📤 Enviando formulario...');
    
    // Enviar el formulario
    form.submit();
    
    return true;
}

// Función para mostrar una sección específica
function mostrarSeccion(funcionarioId) {
    // Ocultar todas las secciones
    document.querySelectorAll('.funcionario-section').forEach(sec => {
        sec.style.display = 'none';
    });
    
    // Mostrar la sección solicitada
    const seccion = document.getElementById(`funcionario-${funcionarioId}`);
    if (seccion) {
        seccion.style.display = 'block';
        seccion.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

function generarUUID() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        const r = Math.random() * 16 | 0;
        const v = c == 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
    });
}

// 👇 ACTUALIZAR la función para recibir string
function mostrarSiguiente(actualId) {
    console.log('Mostrando siguiente después de:', actualId);
    
    const actual = document.getElementById(`funcionario-${actualId}`);
    if (!actual) {
        console.error('No se encontró la sección:', `funcionario-${actualId}`);
        return;
    }
    
    actual.style.display = 'none';
    
    const secciones = document.querySelectorAll('.funcionario-section');
    let mostrarSiguiente = false;
    
    secciones.forEach(seccion => {
        if (mostrarSiguiente) {
            seccion.style.display = 'block';
            mostrarSiguiente = false;
            seccion.scrollIntoView({ behavior: 'smooth', block: 'start' });
            console.log('Mostrando sección:', seccion.id);
        } else if (seccion.id === `funcionario-${actualId}`) {
            mostrarSiguiente = true;
        }
    });
}

// Manejo de opciones de participación
document.addEventListener('DOMContentLoaded', function() {
    const anonimoRadio = document.getElementById('anonimo');
    const conNombreRadio = document.getElementById('con_nombre');
    const campoNombre = document.getElementById('campo_nombre');
    
    anonimoRadio.addEventListener('change', function() {
        campoNombre.style.display = 'none';
        document.getElementById('nombre').value = '';
    });
    
    conNombreRadio.addEventListener('change', function() {
        campoNombre.style.display = 'block';
        document.getElementById('nombre').focus();
    });
    
    // Verificar que el dispositivo_id esté configurado
    const dispositivoIdInput = document.getElementById('dispositivo_id');
    if (!dispositivoIdInput.value) {
        console.warn('Dispositivo ID no configurado al cargar la página');
    } else {
        console.log('Dispositivo ID configurado:', dispositivoIdInput.value);
    }
});
</script>

<%- include('partials/footer') %>
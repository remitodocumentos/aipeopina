<%- include('partials/header') %>

<main>
    <!-- SECCIÓN DE ESTADÍSTICAS -->
    <% if (estadisticas) { %>
    <section class="estadisticas">
        <h3>📊 Participación de la Comunidad</h2>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <div class="stat-info">
                    <h4>Total Participantes</h3>
                    <p class="stat-number"><%= estadisticas.totalParticipantes %></p>
                    <p class="stat-label">Personas han participado</p>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">📈</div>
                <div class="stat-info">
                    <h4>Respuestas Funcionarios</h3>
                    <p class="stat-number"><%= estadisticas.respuestasFuncionarios %></p>
                    <p class="stat-label"><%= estadisticas.participantesFuncionarios %> personas calificaron</p>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">🏢</div>
                <div class="stat-info">
                    <h4>Respuestas Administrativas</h3>
                    <p class="stat-number"><%= estadisticas.respuestasAdministrativas %></p>
                    <p class="stat-label"><%= estadisticas.participantesAdministrativas %> personas calificaron</p>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">🌐</div>
                <div class="stat-info">
                    <h4>Total Visitas</h3>
                    <p class="stat-number"><%= estadisticas.totalVisitas %></p>
                    <p class="stat-label">Dispositivos han visitado</p>
                </div>
            </div>
        </div>
        
        <!-- SECCIÓN DE PROGRESO SIMPLIFICADA -->
        <div class="progreso-participacion">
            <h3>Progreso de Participación</h3>
            <div class="barra-progreso-simple">
                <div class="progreso-item">
                    <div class="progreso-label">
                        <span>Funcionarios: <%= estadisticas.participantesFuncionarios %></span>
                        <span class="porcentaje"><%= estadisticas.porcentajeFuncionarios %>%</span>
                    </div>
                    <div class="progreso-bar">
                        <div class="progreso-fill funcionarios" style="width: 0%;" data-width="<%= estadisticas.porcentajeFuncionarios %>"></div>
                    </div>
                </div>
                <div class="progreso-item">
                    <div class="progreso-label">
                        <span>Administrativa: <%= estadisticas.participantesAdministrativas %></span>
                        <span class="porcentaje"><%= estadisticas.porcentajeAdministrativas %>%</span>
                    </div>
                    <div class="progreso-bar">
                        <div class="progreso-fill administrativas" style="width: 0%;" data-width="<%= estadisticas.porcentajeAdministrativas %>"></div>
                    </div>
                </div>
            </div>
            <p class="info-progreso">
                <strong><%= estadisticas.participantesFuncionarios %></strong> completaron funcionarios • 
                <strong><%= estadisticas.participantesAdministrativas %></strong> completaron administrativa •
                <strong><%= estadisticas.totalParticipantes %></strong> participantes totales
            </p>
        </div>
    </section>
    <% } else { %>
    <div class="estadisticas-error">
        <p>⚠️ Las estadísticas no están disponibles en este momento.</p>
    </div>
    <% } %>
    
    <section class="intro">
        <h2>Tu percepción sobre la administración municipal es importante</h2>
        <p>Tu opinión es fundamental para mejorar nuestro municipio. ¿Cuál es la percepción que tiene de nuestros funcionarios y la gestión administrativa?</p>
        <a href="/evaluacion/funcionarios" class="btn-primary">Comenzar Calificación</a>
    </section>
    
    <section class="info">
        <h3>¿Cómo funciona?</h3>
        <ol>
            <li>Examina a cada funcionario en 13 aspectos clave</li>
            <li>Califica la gestión administrativa por secciones</li>
            <li>Revisa los resultados consolidados de la comunidad</li>
            <li>Revisa los resultados en detalle por participante</li>
            <li>Descarga los resultados en archivo de texto</li>
        </ol>
        <a href="/resultados-inicial" class="btn-secondary">Ver Resultados</a>
    </section>

    <!-- SECCIÓN DE DESCARGA PÚBLICA -->
    <section class="descargas">
        <h3>📥 Descargar Resultados</h3>
        <p>Puedes descargar los resultados completos de las evaluaciones en formato de texto:</p>
        
        <div class="descargas-grid">
            <div class="descarga-card">
                <div class="descarga-icon">👥</div>
                <h4>Resultados de Funcionarios</h4>
                <p>Descarga todas las calificaciones de los funcionarios municipales</p>
                <a href="/descargar/respuestas-funcionarios" class="btn-descarga" download>
                    <i class="fas fa-download"></i>
                    Descargar .TXT
                </a>
            </div>
            
            <div class="descarga-card">
                <div class="descarga-icon">🏢</div>
                <h4>Resultados Administrativos</h4>
                <p>Descarga todas las calificaciones de la gestión administrativa</p>
                <a href="/descargar/respuestas-administrativas" class="btn-descarga" download>
                    <i class="fas fa-download"></i>
                    Descargar .TXT
                </a>
            </div>
        </div>
        
        <div class="info-descarga">
            <p><strong>Formato:</strong> Texto plano con columnas separadas | Fácil de leer</p>
            <p><strong>Incluye:</strong> Todas las respuestas anónimas y con nombre</p>
        </div>
    </section>
</main>

<style>
/* ESTILOS PARA ESTADÍSTICAS */
.estadisticas {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 40px 20px;
    border-radius: 15px;
    margin-bottom: 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.estadisticas h2 {
    text-align: center;
    margin-bottom: 30px;
    font-size: 2rem;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 25px;
    border-radius: 12px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.15);
}

.stat-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
}

.stat-info h3 {
    margin-bottom: 10px;
    font-size: 1.1rem;
    opacity: 0.9;
}

.stat-number {
    font-size: 2.5rem;
    font-weight: bold;
    margin: 10px 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.stat-label {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 0;
}

/* BARRA DE PROGRESO */
.progreso-participacion {
    background: rgba(255, 255, 255, 0.1);
    padding: 25px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.progreso-participacion h3 {
    text-align: center;
    margin-bottom: 20px;
    opacity: 0.9;
}

.barra-progreso {
    background: rgba(255, 255, 255, 0.2);
    height: 50px;
    border-radius: 25px;
    overflow: hidden;
    position: relative;
    margin-bottom: 15px;
    display: flex;
}

.progreso-funcionarios {
    background: linear-gradient(90deg, #4CAF50, #45a049);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 0.8rem;
    transition: width 1.5s ease-in-out;
    min-width: fit-content;
    padding: 0 15px;
}

.progreso-administrativas {
    background: linear-gradient(90deg, #2196F3, #1976D2);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 0.8rem;
    transition: width 1.5s ease-in-out;
    min-width: fit-content;
    padding: 0 15px;
}

.info-progreso {
    text-align: center;
    margin: 0;
    opacity: 0.9;
    font-size: 0.95rem;
}

.estadisticas-error {
    background: #fff3cd;
    color: #856404;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
    margin-bottom: 30px;
    border: 1px solid #ffeaa7;
}

/* ESTILOS EXISTENTES */
.intro {
    text-align: center;
    padding: 40px 20px;
    background: white;
    border-radius: 10px;
    margin-bottom: 30px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.info {
    background: #f8f9fa;
    padding: 30px;
    border-radius: 10px;
    margin-bottom: 30px;
}

.info ol {
    text-align: left;
    margin: 20px 0;
    padding-left: 20px;
}

.info li {
    margin-bottom: 10px;
    line-height: 1.6;
}

.btn-primary, .btn-secondary {
    display: inline-block;
    padding: 12px 30px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: all 0.3s ease;
    margin: 5px;
}

.btn-primary {
    background: #2c5aa0;
    color: white;
}

.btn-primary:hover {
    background: #1a3a6e;
    transform: translateY(-2px);
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn-secondary:hover {
    background: #5a6268;
    transform: translateY(-2px);
}

/* RESPONSIVE */
@media (max-width: 768px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .stat-card {
        padding: 20px;
    }
    
    .stat-number {
        font-size: 2rem;
    }
    
    .barra-progreso {
        height: 80px;
        flex-direction: column;
    }
    
    .progreso-funcionarios,
    .progreso-administrativas {
        height: 50%;
        font-size: 0.7rem;
        padding: 0 10px;
    }
    
    .estadisticas {
        padding: 25px 15px;
    }
}
</style>

<%- include('partials/footer') %>
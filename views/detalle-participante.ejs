<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle por Participante - Aipe Opina</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Detalle de Evaluaciones por Participante</h1>
            <h2>Resultados agrupados por cada persona que participó</h2>
        </header>

        <div class="resultados-container">
            <h2>👥 Detalle por Participante</h2>
            
            <% if (mensaje) { %>
                <div class="sin-resultados">
                    <h3>📊 Resultados en Proceso</h3>
                    <p><%= mensaje %></p>
                    <div class="acciones-resultados">
                        <a href="/evaluacion/funcionarios" class="btn-primary">Ser el primero en participar</a>
                        <a href="/" class="btn-secondary">Volver al Inicio</a>
                    </div>
                </div>
            <% } else { %>
            
            <!-- RESUMEN DE PARTICIPANTES -->
            <div class="resumen-participantes">
                <h3>📈 Resumen General</h3>
                <div class="estadisticas-participantes">
                    <div class="estadistica-item">
                        <span class="numero"><%= participantes.length %></span>
                        <span class="label">Participantes</span>
                    </div>
                    <div class="estadistica-item">
                        <span class="numero">
                            <%= participantes.filter(p => p.total_respuestas_funcionarios > 0).length %>
                        </span>
                        <span class="label">Evaluaron Funcionarios</span>
                    </div>
                    <div class="estadistica-item">
                        <span class="numero">
                            <%= participantes.filter(p => p.total_respuestas_administrativas > 0).length %>
                        </span>
                        <span class="label">Evaluaron Administrativo</span>
                    </div>
                </div>
            </div>

            <!-- LISTA DE PARTICIPANTES -->
            <% participantes.forEach(participante => { %>
            <div class="participante-block" id="participante-<%= participante.id %>">
                <!-- ENCABEZADO DEL PARTICIPANTE -->
                <div class="participante-header">
                    <div class="participante-info">
                        <h3>
                            <% if (participante.nombre && participante.nombre.trim() !== '') { %>
                                👤 <%= participante.nombre %>
                            <% } else { %>
                                👤 Participante Anónimo
                            <% } %>
                        </h3>
                        <div class="participante-meta">
                            <span class="badge <%= participante.tipo_participacion === 'Con nombre' ? 'badge-nombre' : 'badge-anonimo' %>">
                                <%= participante.tipo_participacion %>
                            </span>
                            <span class="dispositivo-id">ID: <%= participante.dispositivo_id %></span>
                            <span class="fechas">
                                Primera respuesta: <%= participante.primera_respuesta %>
                                <% if (participante.ultima_respuesta !== participante.primera_respuesta) { %>
                                • Última: <%= participante.ultima_respuesta %>
                                <% } %>
                            </span>
                        </div>
                    </div>
                    <div class="participante-stats">
                        <span class="stat">
                            <strong><%= participante.total_respuestas_funcionarios || 0 %></strong> funcionarios
                        </span>
                        <span class="stat">
                            <strong><%= participante.total_respuestas_administrativas || 0 %></strong> administrativas
                        </span>
                    </div>
                </div>

                <!-- SECCIÓN DE FUNCIONARIOS -->
                <% if (resultadosPorParticipante.funcionarios[participante.id] && resultadosPorParticipante.funcionarios[participante.id].length > 0) { %>
                <div class="seccion-participante">
                    <h4>🏛️ Evaluación de Funcionarios</h4>
                    
                    <% let funcionarioActual = null; %>
                    <% resultadosPorParticipante.funcionarios[participante.id].forEach(resultado => { %>
                        <% if (funcionarioActual !== resultado.funcionario_id) { %>
                            <% if (funcionarioActual !== null) { %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="funcionario-participante">
                                <h5><%= resultado.funcionario_nombre %> - <%= resultado.cargo %></h5>
                                <div class="preguntas-participante">
                            <% funcionarioActual = resultado.funcionario_id; %>
                        <% } %>
                        
                        <div class="respuesta-participante">
                            <span class="pregunta-texto"><%= resultado.pregunta_texto %></span>
                            <span class="respuesta-valor <%= resultado.respuesta %>">
                                <%= resultado.respuesta %>
                            </span>
                        </div>
                    <% }); %>
                    
                    <% if (funcionarioActual !== null) { %>
                            </div>
                        </div>
                    <% } %>
                </div>
                <% } %>

                <!-- SECCIÓN ADMINISTRATIVA -->
                <% if (resultadosPorParticipante.administrativas[participante.id] && resultadosPorParticipante.administrativas[participante.id].length > 0) { %>
                <div class="seccion-participante">
                    <h4>🏢 Evaluación Administrativa</h4>
                    
                    <% let seccionActual = null; %>
                    <% resultadosPorParticipante.administrativas[participante.id].forEach(resultado => { %>
                        <% if (seccionActual !== resultado.seccion_id) { %>
                            <% if (seccionActual !== null) { %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="seccion-participante-item">
                                <h5><%= resultado.seccion_nombre %></h5>
                                <div class="preguntas-participante">
                            <% seccionActual = resultado.seccion_id; %>
                        <% } %>
                        
                        <div class="respuesta-participante">
                            <span class="pregunta-texto"><%= resultado.pregunta_texto %></span>
                            <span class="respuesta-valor <%= resultado.respuesta %>">
                                <%= resultado.respuesta %>
                            </span>
                        </div>
                    <% }); %>
                    
                    <% if (seccionActual !== null) { %>
                            </div>
                        </div>
                    <% } %>
                </div>
                <% } %>

                <!-- SEPARADOR ENTRE PARTICIPANTES -->
                <div class="participante-separator"></div>
            </div>
            <% }); %>
            
            <!-- BOTONES DE NAVEGACIÓN -->
            <div class="navegacion-resultados">
                <div class="acciones-navegacion">
                    <a href="/resultados" class="btn-primary">
                        <span class="icono">📊</span>
                        Ver Resultados Consolidados
                    </a>
                    <a href="/" class="btn-inicio">
                        <span class="icono">🏠</span>
                        Volver al Inicio
                    </a>
                </div>
            </div>
            
            <% } %>
        </div>

        <footer>
            <p>&copy; <%= new Date().getFullYear() %> - Aipe Somos Todos -. Todos los derechos reservados.</p>
        </footer>
    </div>

    <style>
        /* ESTILOS PARA VISTA POR PARTICIPANTE */
        .resumen-participantes {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .estadisticas-participantes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }

        .estadistica-item {
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 8px;
        }

        .estadistica-item .numero {
            display: block;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .estadistica-item .label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .participante-block {
            background: white;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            border: 1px solid #e9ecef;
        }

        .participante-header {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px 10px 0 0;
            border-bottom: 2px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .participante-info h3 {
            color: #2c5aa0;
            margin-bottom: 10px;
            font-size: 1.3rem;
        }

        .participante-meta {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            align-items: center;
        }

        .badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .badge-nombre {
            background: #d4edda;
            color: #155724;
        }

        .badge-anonimo {
            background: #e2e3e5;
            color: #383d41;
        }

        .dispositivo-id {
            font-family: 'Courier New', monospace;
            background: #f8f9fa;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            color: #6c757d;
        }

        .fechas {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .participante-stats {
            display: flex;
            flex-direction: column;
            gap: 5px;
            text-align: right;
        }

        .participante-stats .stat {
            background: white;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .seccion-participante {
            padding: 20px;
        }

        .seccion-participante h4 {
            color: #495057;
            margin-bottom: 20px;
            font-size: 1.2rem;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 10px;
        }

        .funcionario-participante, .seccion-participante-item {
            margin-bottom: 25px;
            padding: 15px;
            background: #fafafa;
            border-radius: 8px;
            border-left: 4px solid #2c5aa0;
        }

        .seccion-participante-item {
            border-left-color: #f39c12;
        }

        .funcionario-participante h5, .seccion-participante-item h5 {
            color: #2c5aa0;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .preguntas-participante {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 10px;
        }

        .respuesta-participante {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 15px;
            background: white;
            border-radius: 6px;
            border: 1px solid #e9ecef;
        }

        .pregunta-texto {
            flex: 1;
            font-weight: 500;
            color: #495057;
        }

        .respuesta-valor {
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: capitalize;
            margin-left: 10px;
        }

        /* Colores para las respuestas */
        .respuesta-valor.excelente {
            background: #d4edda;
            color: #155724;
        }

        .respuesta-valor.bueno {
            background: #d1ecf1;
            color: #0c5460;
        }

        .respuesta-valor.regular {
            background: #fff3cd;
            color: #856404;
        }

        .respuesta-valor.deficiente {
            background: #f8d7da;
            color: #721c24;
        }

        .respuesta-valor.malo {
            background: #e2e3e5;
            color: #383d41;
        }

        .participante-separator {
            height: 2px;
            background: linear-gradient(90deg, transparent, #e9ecef, transparent);
            margin: 0 20px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .participante-header {
                flex-direction: column;
                gap: 15px;
            }

            .participante-stats {
                flex-direction: row;
                text-align: left;
                width: 100%;
            }

            .preguntas-participante {
                grid-template-columns: 1fr;
            }

            .respuesta-participante {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .respuesta-valor {
                align-self: flex-end;
            }
        }
    </style>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <% if (tipoVista === 'inicial') { %>
            Resultados Parciales - Aipe Opina
        <% } else if (tipoVista === 'final') { %>
            Resultados Completos - Aipe Opina
        <% } else { %>
            Resultados - Aipe Opina
        <% } %>
    </title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>
                <% if (tipoVista === 'inicial') { %>
                    Así opina la comunidad de Aipe
                <% } else if (tipoVista === 'final') { %>
                    Resultados Consolidados
                <% } else { %>
                    Resultados de la Evaluación
                <% } %>
            </h1>
            
            <% if (tipoVista === 'inicial') { %>
                <h2>Evaluación de Funcionarios Completada</h2>
            <% } else if (tipoVista === 'final') { %>
                <h2>Evaluación Completa Finalizada</h2>
            <% } %>
        </header>

        <div class="resultados-container">
            <h2>
                <% if (tipoVista === 'inicial') { %>
                    📊 Resultados Parciales
                <% } else if (tipoVista === 'final') { %>
                    🎯 Resultados Consolidados
                <% } else { %>
                    📈 Resultados Generales
                <% } %>
            </h2>
            
            <% if (mensaje) { %>
                <div class="sin-resultados">
                    <h3>📊 Resultados en Proceso</h3>
                    <p><%= mensaje %></p>
                    <div class="acciones-resultados">
                        <a href="/evaluacion/funcionarios" class="btn-primary">Ser el primero en participar</a>
                        <a href="/" class="btn-secondary">Volver al inicio</a>
                    </div>
                </div>
            <% } else { %>
            
            <!-- SECCIÓN DE FUNCIONARIOS (SIEMPRE VISIBLE) -->
            <section class="resultados-funcionarios">
                <h3>Calificación de Funcionarios</h3>
                
                <% if (!resultadosFuncionarios || resultadosFuncionarios.length === 0) { %>
                    <div class="sin-datos">
                        <p>📝 Aún no hay calificaciones para funcionarios.</p>
                    </div>
                <% } else { %>
                    <!-- Mismo código de funcionarios para todos los tipos -->
                    <% let funcionarioActual = null; %>
                    <% let preguntaActual = null; %>
                    
                    <% resultadosFuncionarios.forEach(resultado => { %>
                        <% if (funcionarioActual !== resultado.funcionario_id) { %>
                            <% if (funcionarioActual !== null) { %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="funcionario-resultados">
                                <h4><%= resultado.funcionario_nombre %> - <%= resultado.cargo %></h4>
                            <% funcionarioActual = resultado.funcionario_id; %>
                        <% } %>
                        
                        <% if (preguntaActual !== resultado.pregunta_id) { %>
                            <% if (preguntaActual !== null) { %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="pregunta-resultados">
                                <h5><%= resultado.pregunta_texto %></h5>
                                <div class="resultados-grafica">
                            <% preguntaActual = resultado.pregunta_id; %>
                        <% } %>
                        
                        <div class="resultado-item">
                            <span class="respuesta-label"><%= resultado.respuesta %>:</span>
                            <div class="barra-container">
                                <div class="barra" style="width: 0%;" data-cantidad="<%= resultado.cantidad %>"></div>
                            </div>
                            <span class="cantidad"><%= resultado.cantidad %></span>
                        </div>
                    <% }); %>
                    
                    <% if (funcionarioActual !== null) { %>
                            </div>
                        </div>
                    </div>
                    <% } %>
                <% } %>
            </section>
            
            <!-- SECCIÓN ADMINISTRATIVA (SIEMPRE VISIBLE) -->
            <section class="resultados-administrativos">
                <h3>Calificación Administrativa</h3>
                
                <% if (!resultadosAdministrativos || resultadosAdministrativos.length === 0) { %>
                    <div class="sin-datos">
                        <p>📋 Aún no hay calificaciones para la gestión administrativa.</p>
                    </div>
                <% } else { %>
                    <!-- Mismo código administrativo para todos los tipos -->
                    <% let seccionActual = null; %>
                    <% let preguntaActual = null; %>
                    
                    <% resultadosAdministrativos.forEach(resultado => { %>
                        <% if (seccionActual !== resultado.seccion_id) { %>
                            <% if (seccionActual !== null) { %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="seccion-resultados">
                                <h4><%= resultado.seccion_nombre %></h4>
                            <% seccionActual = resultado.seccion_id; %>
                        <% } %>
                        
                        <% if (preguntaActual !== resultado.pregunta_id) { %>
                            <% if (preguntaActual !== null) { %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="pregunta-resultados">
                                <h5><%= resultado.pregunta_texto %></h5>
                                <div class="resultados-grafica">
                            <% preguntaActual = resultado.pregunta_id; %>
                        <% } %>
                        
                        <div class="resultado-item">
                            <span class="respuesta-label"><%= resultado.respuesta %>:</span>
                            <div class="barra-container">
                                <div class="barra" style="width: 0%;" data-cantidad="<%= resultado.cantidad %>"></div>
                            </div>
                            <span class="cantidad"><%= resultado.cantidad %></span>
                        </div>
                    <% }); %>
                    
                    <% if (seccionActual !== null) { %>
                            </div>
                        </div>
                    </div>
                    <% } %>
                <% } %>
            </section>

            <!-- BOTONES DINÁMICOS SEGÚN EL TIPO DE VISTA -->
            <div class="navegacion-resultados">
                <div class="acciones-navegacion">
                    <% if (tipoVista === 'inicial') { %>
                        <!-- VISTA INICIAL: Después de funcionarios -->
                        <a href="/evaluacion/administrativo" class="btn-continuar">
                            <span class="icono">➡️</span>
                            Continuar con Evaluación Administrativa
                        </a>
                        <a href="/" class="btn-inicio">
                            <span class="icono">🏠</span>
                            Volver al Inicio
                        </a>
                        
                    <% } else if (tipoVista === 'final') { %>
                        <!-- VISTA FINAL: Después de completar todo -->
                        <a href="/" class="btn-inicio">
                            <span class="icono">🏠</span>
                            Volver al Inicio
                        </a>
                        <a href="/resultados/inicial" class="btn-comparar">
                            <span class="icono">📊</span>
                            Ver Resultados Parciales
                        </a>
                        
                    <% } else { %>
                        <!-- VISTA GENERAL: Página principal de resultados -->
                        <a href="/evaluacion/funcionarios" class="btn-participar">
                            <span class="icono">📝</span>
                            Participar en la Evaluación
                        </a>
                        <a href="/" class="btn-inicio">
                            <span class="icono">🏠</span>
                            Volver al Inicio
                        </a>
                    <% } %>
                </div>
                
                <div class="info-navegacion">
                    <% if (tipoVista === 'inicial') { %>
                        <p>💡 <strong>¿Ya terminaste con los funcionarios?</strong> Continúa con la evaluación administrativa para completar tu participación.</p>
                    <% } else if (tipoVista === 'final') { %>
                        <p>🎉 <strong>¡Evaluación completada!</strong> Gracias por tu participación en ambas evaluaciones.</p>
                    <% } else { %>
                        <p>👀 <strong>Resultados consolidados</strong> de todas las evaluaciones realizadas por la comunidad.</p>
                    <% } %>
                </div>
            </div>
            
            <% } %>
        </div>

        <footer>
            <p>&copy; <%= new Date().getFullYear() %> - Aipe Somos Todos -. Todos los derechos reservados.</p>
        </footer>
    </div>

    <!-- MISMO SCRIPT PARA TODOS -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Inicializando gráficas para vista: <%= tipoVista %>');
        
        const barras = document.querySelectorAll('.barra');
        
        barras.forEach(barra => {
            try {
                const cantidad = parseInt(barra.getAttribute('data-cantidad'));
                const preguntaDiv = barra.closest('.pregunta-resultados');
                
                if (!preguntaDiv) return;
                
                const cantidades = preguntaDiv.querySelectorAll('.cantidad');
                let total = 0;
                cantidades.forEach(c => {
                    total += parseInt(c.textContent) || 0;
                });
                
                const porcentaje = total > 0 ? (cantidad / total) * 100 : 0;
                
                setTimeout(() => {
                    barra.style.width = porcentaje + '%';
                }, 100);
                
                // Colores según respuesta
                const resultadoItem = barra.closest('.resultado-item');
                if (resultadoItem) {
                    const respuestaLabel = resultadoItem.querySelector('.respuesta-label');
                    if (respuestaLabel) {
                        const respuesta = respuestaLabel.textContent.toLowerCase();
                        const colores = {
                            'excelente': '#27ae60',
                            'bueno': '#2ecc71',
                            'regular': '#f39c12',
                            'deficiente': '#e67e22',
                            'malo': '#e74c3c'
                        };
                        barra.style.backgroundColor = colores[respuesta] || '#2c5aa0';
                    }
                }
            } catch (error) {
                console.error('Error inicializando barra:', error);
            }
        });
    });
    </script>
</body>
</html>
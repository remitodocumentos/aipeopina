<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <% if (tipoVista === 'inicial') { %>
            Resultados Parciales - Aipe Opina
        <% } else if (tipoVista === 'final') { %>
            Resultados Completos - Aipe Opina
        <% } else { %>
            Resultados - Aipe Opina
        <% } %>
    </title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>
                <% if (tipoVista === 'inicial') { %>
                    Así opina la comunidad de Aipe
                <% } else if (tipoVista === 'final') { %>
                    Resultados Consolidados
                <% } else { %>
                    Resultados de la Evaluación
                <% } %>
            </h1>
            
            <% if (tipoVista === 'inicial') { %>
                <h2>Evaluación de Funcionarios Completada</h2>
            <% } else if (tipoVista === 'final') { %>
                <h2>Evaluación Completa Finalizada</h2>
            <% } %>
        </header>

        <div class="resultados-container">
            <h2>
                <% if (tipoVista === 'inicial') { %>
                    📊 Resultados Parciales
                <% } else if (tipoVista === 'final') { %>
                    🎯 Resultados Consolidados
                <% } else { %>
                    📈 Resultados Generales
                <% } %>
            </h2>
            
            <% if (error) { %>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <%= error %>
                </div>
            <% } %>
            
            <% if (mensaje) { %>
                <div class="sin-resultados">
                    <h3>📊 Resultados en Proceso</h3>
                    <p><%= mensaje %></p>
                    <div class="acciones-resultados">
                        <a href="/evaluacion/funcionarios" class="btn-primary">Ser el primero en participar</a>
                        <a href="/" class="btn-secondary">Volver al Inicio</a>
                    </div>
                </div>
            <% } else if ((!resultadosFuncionarios || resultadosFuncionarios.length === 0) && (!resultadosAdministrativos || resultadosAdministrativos.length === 0)) { %>
                <div class="sin-resultados">
                    <h3>📊 No hay resultados aún</h3>
                    <p>Aún no se han registrado evaluaciones. Sé el primero en participar.</p>
                    <div class="acciones-resultados">
                        <a href="/evaluacion/funcionarios" class="btn-primary">Comenzar Evaluación</a>
                        <a href="/" class="btn-secondary">Volver al Inicio</a>
                    </div>
                </div>
            <% } else { %>
            
            <!-- RESUMEN SIMPLE DE RESULTADOS -->
            <div class="resumen-resultados">
                <h3>📊 Resumen de Resultados</h3>
                <div class="estadisticas-resultados">
                    <div class="estadistica-item">
                        <span class="numero">
                            <% 
                            let funcionariosUnicos = new Set();
                            if (resultadosFuncionarios && resultadosFuncionarios.length > 0) {
                                resultadosFuncionarios.forEach(r => funcionariosUnicos.add(r.funcionario_id));
                            }
                            %>
                            <%= funcionariosUnicos.size %>
                        </span>
                        <span class="label">Funcionarios Evaluados</span>
                    </div>
                    <div class="estadistica-item">
                        <span class="numero">
                            <% 
                            let seccionesUnicas = new Set();
                            if (resultadosAdministrativos && resultadosAdministrativos.length > 0) {
                                resultadosAdministrativos.forEach(r => seccionesUnicas.add(r.seccion_id));
                            }
                            %>
                            <%= seccionesUnicas.size %>
                        </span>
                        <span class="label">Secciones Evaluadas</span>
                    </div>
                    <div class="estadistica-item">
                        <span class="numero"><%= resultadosFuncionarios ? resultadosFuncionarios.length : 0 %></span>
                        <span class="label">Respuestas Funcionarios</span>
                    </div>
                    <div class="estadistica-item">
                        <span class="numero"><%= resultadosAdministrativos ? resultadosAdministrativos.length : 0 %></span>
                        <span class="label">Respuestas Administrativas</span>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN DE FUNCIONARIOS -->
            <% if (resultadosFuncionarios && resultadosFuncionarios.length > 0) { %>
            <section class="resultados-funcionarios">
                <h3>Calificación de Funcionarios</h3>
                
                <% let funcionarioActual = null; %>
                <% let preguntaActual = null; %>
                <% let funcionarioCount = 0; %>
                
                <% resultadosFuncionarios.forEach(resultado => { %>
                    <% if (funcionarioActual !== resultado.funcionario_id) { %>
                        <% if (funcionarioActual !== null) { %>
                                </div>
                            </div>
                        <% } %>
                        <div class="funcionario-resultados">
                            <h4><%= resultado.funcionario_nombre %> - <%= resultado.cargo %></h4>
                        <% funcionarioActual = resultado.funcionario_id; %>
                        <% funcionarioCount++; %>
                    <% } %>
                    
                    <% if (preguntaActual !== resultado.pregunta_id) { %>
                        <% if (preguntaActual !== null) { %>
                                </div>
                            </div>
                        <% } %>
                        <div class="pregunta-resultados">
                            <h5><%= resultado.pregunta_texto %></h5>
                            <div class="resultados-grafica">
                        <% preguntaActual = resultado.pregunta_id; %>
                    <% } %>
                    
                    <div class="resultado-item">
                        <span class="respuesta-label"><%= resultado.respuesta %>:</span>
                        <div class="barra-container">
                            <div class="barra" style="width: 0%;" data-cantidad="<%= resultado.cantidad %>"></div>
                        </div>
                        <span class="cantidad"><%= resultado.cantidad %></span>
                    </div>
                <% }); %>
                
                <% if (funcionarioCount > 0) { %>
                        </div>
                    </div>
                </div>
                <% } %>
            </section>
            <% } %>
            
            <!-- SECCIÓN ADMINISTRATIVA -->
            <% if (resultadosAdministrativos && resultadosAdministrativos.length > 0) { %>
            <section class="resultados-administrativos">
                <h3>Calificación Administrativa</h3>
                
                <% let seccionActual = null; %>
                <% let preguntaActual = null; %>
                <% let seccionCount = 0; %>
                
                <% resultadosAdministrativos.forEach(resultado => { %>
                    <% if (seccionActual !== resultado.seccion_id) { %>
                        <% if (seccionActual !== null) { %>
                                </div>
                            </div>
                        <% } %>
                        <div class="seccion-resultados">
                            <h4><%= resultado.seccion_nombre %></h4>
                        <% seccionActual = resultado.seccion_id; %>
                        <% seccionCount++; %>
                    <% } %>
                    
                    <% if (preguntaActual !== resultado.pregunta_id) { %>
                        <% if (preguntaActual !== null) { %>
                                </div>
                            </div>
                        <% } %>
                        <div class="pregunta-resultados">
                            <h5><%= resultado.pregunta_texto %></h5>
                            <div class="resultados-grafica">
                        <% preguntaActual = resultado.pregunta_id; %>
                    <% } %>
                    
                    <div class="resultado-item">
                        <span class="respuesta-label"><%= resultado.respuesta %>:</span>
                        <div class="barra-container">
                            <div class="barra" style="width: 0%;" data-cantidad="<%= resultado.cantidad %>"></div>
                        </div>
                        <span class="cantidad"><%= resultado.cantidad %></span>
                    </div>
                <% }); %>
                
                <% if (seccionCount > 0) { %>
                        </div>
                    </div>
                </div>
                <% } %>
            </section>
            <% } %>

            <!-- BOTONES DE NAVEGACIÓN -->
            <div class="navegacion-resultados">
                <div class="acciones-navegacion">
                    <!-- Botón para ver detalle por participante -->
                    <a href="/detalle-participante" class="btn-detalle">
                        <span class="icono">👥</span>
                        Ver Detalle por Participante
                    </a>
                    
                    <% if (tipoVista === 'inicial') { %>
                        <a href="/evaluacion/administrativo" class="btn-continuar">
                            <span class="icono">➡️</span>
                            Continuar con Evaluación Administrativa
                        </a>
                    <% } %>
                    
                    <a href="/" class="btn-inicio">
                        <span class="icono">🏠</span>
                        Volver al Inicio
                    </a>
                </div>
            </div>
            
            <% } %>
        </div>

        <footer>
            <p>&copy; <%= new Date().getFullYear() %> - Aipe Somos Todos -. Todos los derechos reservados.</p>
        </footer>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Inicializando gráficas de resultados...');
        
        const barras = document.querySelectorAll('.barra');
        
        barras.forEach(barra => {
            try {
                const cantidad = parseInt(barra.getAttribute('data-cantidad'));
                const preguntaDiv = barra.closest('.pregunta-resultados');
                
                if (!preguntaDiv) return;
                
                const cantidades = preguntaDiv.querySelectorAll('.cantidad');
                let total = 0;
                cantidades.forEach(c => {
                    total += parseInt(c.textContent) || 0;
                });
                
                const porcentaje = total > 0 ? (cantidad / total) * 100 : 0;
                
                setTimeout(() => {
                    barra.style.width = porcentaje + '%';
                }, 100);
                
                // Asignar color según la respuesta
                const resultadoItem = barra.closest('.resultado-item');
                if (resultadoItem) {
                    const respuestaLabel = resultadoItem.querySelector('.respuesta-label');
                    if (respuestaLabel) {
                        const respuesta = respuestaLabel.textContent.toLowerCase().replace(':', '').trim();
                        const colores = {
                            'excelente': '#27ae60',
                            'bueno': '#2ecc71',
                            'regular': '#f39c12',
                            'deficiente': '#e67e22',
                            'malo': '#e74c3c'
                        };
                        barra.style.backgroundColor = colores[respuesta] || '#2c5aa0';
                    }
                }
            } catch (error) {
                console.error('Error inicializando barra:', error);
            }
        });
    });
    </script>

    <style>
        .btn-detalle {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 25px;
            background: linear-gradient(135deg, #6f42c1, #e83e8c);
            color: white;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .btn-detalle:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, #5a2d91, #c21767);
            box-shadow: 0 5px 15px rgba(111, 66, 193, 0.3);
        }
   
        /* ESTILOS PARA VISTA POR PARTICIPANTE */
        .resumen-participantes {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .estadisticas-participantes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }

        .estadistica-item {
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 8px;
        }

        .estadistica-item .numero {
            display: block;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .estadistica-item .label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .participante-block {
            background: white;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            border: 1px solid #e9ecef;
        }

        .participante-header {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px 10px 0 0;
            border-bottom: 2px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .participante-info h3 {
            color: #2c5aa0;
            margin-bottom: 10px;
            font-size: 1.3rem;
        }

        .participante-meta {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            align-items: center;
        }

        .badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .badge-nombre {
            background: #d4edda;
            color: #155724;
        }

        .badge-anonimo {
            background: #e2e3e5;
            color: #383d41;
        }

        .dispositivo-id {
            font-family: 'Courier New', monospace;
            background: #f8f9fa;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            color: #6c757d;
        }

        .fechas {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .participante-stats {
            display: flex;
            flex-direction: column;
            gap: 5px;
            text-align: right;
        }

        .participante-stats .stat {
            background: white;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .seccion-participante {
            padding: 20px;
        }

        .seccion-participante h4 {
            color: #495057;
            margin-bottom: 20px;
            font-size: 1.2rem;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 10px;
        }

        .funcionario-participante, .seccion-participante-item {
            margin-bottom: 25px;
            padding: 15px;
            background: #fafafa;
            border-radius: 8px;
            border-left: 4px solid #2c5aa0;
        }

        .seccion-participante-item {
            border-left-color: #f39c12;
        }

        .funcionario-participante h5, .seccion-participante-item h5 {
            color: #2c5aa0;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .preguntas-participante {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 10px;
        }

        .respuesta-participante {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 15px;
            background: white;
            border-radius: 6px;
            border: 1px solid #e9ecef;
        }

        .pregunta-texto {
            flex: 1;
            font-weight: 500;
            color: #495057;
        }

        .respuesta-valor {
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: capitalize;
            margin-left: 10px;
        }

        /* Colores para las respuestas */
        .respuesta-valor.excelente {
            background: #d4edda;
            color: #155724;
        }

        .respuesta-valor.bueno {
            background: #d1ecf1;
            color: #0c5460;
        }

        .respuesta-valor.regular {
            background: #fff3cd;
            color: #856404;
        }

        .respuesta-valor.deficiente {
            background: #f8d7da;
            color: #721c24;
        }

        .respuesta-valor.malo {
            background: #e2e3e5;
            color: #383d41;
        }

        .participante-separator {
            height: 2px;
            background: linear-gradient(90deg, transparent, #e9ecef, transparent);
            margin: 0 20px;
        }

        .btn-detalle {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 15px 30px;
            background: linear-gradient(135deg, #6f42c1, #e83e8c);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .btn-detalle:hover {
            transform: translateY(-3px);
            background: linear-gradient(135deg, #5a2d91, #c21767);
            box-shadow: 0 5px 15px rgba(111, 66, 193, 0.3);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .participante-header {
                flex-direction: column;
                gap: 15px;
            }

            .participante-stats {
                flex-direction: row;
                text-align: left;
                width: 100%;
            }

            .preguntas-participante {
                grid-template-columns: 1fr;
            }

            .respuesta-participante {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .respuesta-valor {
                align-self: flex-end;
            }
        }
    </style>
</body>
</html>